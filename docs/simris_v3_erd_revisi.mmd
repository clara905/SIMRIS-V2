    %% =====================================================
    %% SIMRIS v3 - revisi laporan Lampiran 14 dan integritas historis
    %% Versi revisi: bagian yang diubah/ditambah diberi tanda [REVISI]
    %% =====================================================

    %% ---------- ORGANISASI, PEGAWAI, AKSES ----------
    UNIT_ORGANISASI {
        bigint id PK
        bigint parent_id FK "NULL untuk satker"
        varchar kode UK
        varchar nama
        varchar jenis "SATKER BIDANG BAGIAN SUBBIDANG SUBBAGIAN"
        boolean aktif
    }

    PEGAWAI {
        bigint id PK
        varchar nip UK "Nullable untuk non-PNS"
        varchar nama
        varchar email_kontak
        varchar jenis_kepegawaian
        boolean aktif
    }

    %% [REVISI] Periode penempatan satu pegawai tidak boleh tumpang tindih (exclusion constraint/validasi service)
    PENEMPATAN_PEGAWAI {
        bigint id PK
        bigint pegawai_id FK
        bigint unit_id FK
        date mulai
        date selesai "Nullable"
    }

    USERS {
        bigint id PK
        bigint pegawai_id FK,UK "Nullable untuk akun sistem"
        varchar username UK
        varchar email_login UK
        varchar password_hash
        boolean aktif
    }

    ROLES {
        bigint id PK
        varchar kode UK "SUPER_ADMIN ADMIN_SATKER KASATKER KABID KASUB STAFF"
        varchar nama
    }

    %% [REVISI] UNIQUE (user_id, role_id, unit_id, mulai)
    %% [REVISI] unit_id NULL hanya boleh untuk role SUPER_ADMIN (trigger/CHECK berbasis role).
    %%          Pada UNIQUE, NULL dianggap berbeda, sehingga baris SUPER_ADMIN perlu dijaga lewat service.
    USER_ROLE_SCOPE {
        bigint id PK
        bigint user_id FK
        bigint role_id FK
        bigint unit_id FK "NULL hanya untuk SUPER_ADMIN"
        datetime mulai
        datetime selesai "Nullable"
    }

    LOG_AUDIT {
        bigint id PK
        bigint user_id FK "Nullable untuk proses sistem"
        varchar entitas
        bigint entitas_id
        varchar aksi "CREATE UPDATE DELETE LOGIN APPROVE"
        json data_lama "Nullable"
        json data_baru "Nullable"
        varchar ip_address
        datetime waktu
    }

    %% ---------- ASET ----------
    SUMBER_ASET {
        bigint id PK
        varchar kode UK
        varchar nama
    }

    KATEGORI_ASET {
        bigint id PK
        bigint parent_id FK "Nullable untuk kategori teratas"
        varchar kode UK
        varchar nama
    }

    KLASIFIKASI_INFORMASI {
        bigint id PK
        varchar kode UK
        varchar nama
        text deskripsi
    }

    ASET {
        bigint id PK
        bigint sumber_id FK "UK gabungan dengan external_id"
        varchar external_id
        bigint unit_pemilik_id FK
        bigint kategori_id FK
        bigint klasifikasi_informasi_id FK "Nullable"
        varchar kode_aset UK
        varchar nama
        text deskripsi
        varchar merk
        varchar nomor_seri "Nullable untuk kelompok aset"
        int jumlah
        varchar kondisi
        varchar lokasi
        date tanggal_pengadaan
        varchar status
        datetime last_synced_at
    }

    %% [REVISI] Periode penugasan aset yang sama untuk jenis_tanggung_jawab yang sama tidak boleh tumpang tindih
    PENUGASAN_ASET {
        bigint id PK
        bigint aset_id FK
        bigint pegawai_id FK
        varchar jenis_tanggung_jawab
        date mulai
        date selesai "Nullable"
    }

    %% ---------- METODE RISIKO (BERVERSI) ----------
    PERIODE_PENILAIAN {
        bigint id PK
        varchar nama
        date tanggal_mulai
        date tanggal_selesai
    }

    %% [REVISI] Tambah dibekukan_pada. Versi wajib dibekukan sebelum dipakai ASESMEN_RISIKO.
    VERSI_METODE_RISIKO {
        bigint id PK
        varchar nama
        varchar versi
        text referensi
        boolean dibekukan
        datetime dibekukan_pada "Nullable sebelum dibekukan"
    }

    SKALA_KEMUNGKINAN {
        bigint id PK
        bigint versi_metode_id FK
        int nilai "UK gabungan dengan versi_metode_id"
        varchar label
        varchar label_persentase
        varchar label_frekuensi
        text kriteria
    }

    SKALA_DAMPAK {
        bigint id PK
        bigint versi_metode_id FK
        int nilai "UK gabungan dengan versi_metode_id"
        varchar label
        text kriteria
    }

    %% [REVISI] Tambah aktif: master yang sudah dipakai hanya boleh dinonaktifkan, tidak diubah isinya
    AREA_DAMPAK {
        bigint id PK
        varchar kode UK
        varchar nama
        boolean aktif
    }

    %% UNIQUE (skala_dampak_id, area_dampak_id, arah_dampak)
    KRITERIA_DAMPAK {
        bigint id PK
        bigint skala_dampak_id FK "UK gabungan dengan area_dampak_id dan arah_dampak"
        bigint area_dampak_id FK
        varchar arah_dampak "P atau N"
        text deskripsi
    }

    TINGKAT_RISIKO {
        bigint id PK
        bigint versi_metode_id FK
        varchar kode
        varchar nama
        varchar warna
    }

    %% [REVISI] UNIQUE (versi_metode_id, kemungkinan_id, dampak_id)
    %% [REVISI] kemungkinan_id, dampak_id, dan tingkat_risiko_id harus berasal dari versi_metode_id yang sama
    MATRIKS_RISIKO {
        bigint id PK
        bigint versi_metode_id FK "UK gabungan dengan kemungkinan_id dan dampak_id"
        bigint kemungkinan_id FK
        bigint dampak_id FK
        bigint tingkat_risiko_id FK
        int skor
        varchar rekomendasi_keputusan
    }

    %% ---------- ASESMEN RISIKO ----------
    %% [REVISI] UNIQUE (seri_asesmen_id, nomor_versi)
    %% [REVISI] versi_metode_id harus berstatus dibekukan
    ASESMEN_RISIKO {
        bigint id PK
        bigint seri_asesmen_id FK "UK gabungan dengan nomor_versi"
        bigint versi_sebelumnya_id FK "Nullable untuk versi pertama"
        bigint periode_id FK
        bigint unit_id FK
        bigint versi_metode_id FK
        bigint dibuat_oleh FK
        text tujuan
        text ruang_lingkup
        varchar status "DRAFT DIAJUKAN DIREVIU DISAHKAN"
        int nomor_versi
        datetime dibuat_pada
        datetime dibekukan_pada "Nullable sebelum disahkan"
    }

    %% [REVISI] Tambah aktif pada JENIS_ANCAMAN, ANCAMAN, JENIS_KERENTANAN, KERENTANAN
    JENIS_ANCAMAN {
        bigint id PK
        varchar kode UK
        varchar nama
        boolean aktif
    }

    SUMBER_ANCAMAN {
        bigint id PK
        varchar kode UK
        varchar nama
        text deskripsi
    }

    ANCAMAN {
        bigint id PK
        bigint jenis_ancaman_id FK
        varchar kode UK
        varchar nama
        text deskripsi
        boolean aktif
    }

    ANCAMAN_SUMBER {
        bigint ancaman_id PK,FK
        bigint sumber_ancaman_id PK,FK
    }

    JENIS_KERENTANAN {
        bigint id PK
        varchar kode UK
        varchar nama
        boolean aktif
    }

    KERENTANAN {
        bigint id PK
        bigint jenis_kerentanan_id FK
        varchar kode UK
        varchar nama
        text deskripsi
        boolean aktif
    }

    %% [REVISI] UNIQUE (id, asesmen_id) agar bisa dirujuk composite FK dari RISIKO_ASET dan RISIKO_PENANGANAN
    %% [REVISI] Tambah snapshot master agar risiko yang sudah disahkan tidak berubah saat master diedit
    RISIKO {
        bigint id PK "UK gabungan dengan asesmen_id"
        bigint asesmen_id FK
        bigint ancaman_id FK
        bigint kerentanan_id FK
        bigint area_dampak_id FK
        bigint pemilik_risiko_id FK
        bigint dibuat_oleh FK
        varchar kode "UK gabungan dengan asesmen_id"
        text skenario
        text uraian_kerentanan "Konteks spesifik"
        text uraian_dampak
        varchar arah_dampak "P atau N"
        varchar kode_ancaman_snapshot
        varchar nama_ancaman_snapshot
        varchar kode_kerentanan_snapshot
        varchar nama_kerentanan_snapshot
        varchar nama_area_dampak_snapshot
        varchar pemilik_risiko_snapshot "Nama dan unit pemilik saat disahkan"
        datetime dibuat_pada
    }

    %% [REVISI] UNIQUE (id, asesmen_id)
    %% [REVISI] Snapshot dilengkapi untuk kebutuhan laporan Lampiran 14
    ASESMEN_ASET {
        bigint id PK "UK gabungan dengan asesmen_id"
        bigint asesmen_id FK "UK gabungan dengan aset_id"
        bigint aset_id FK
        varchar kode_aset_snapshot
        varchar nama_snapshot
        varchar kategori_snapshot
        varchar klasifikasi_informasi_snapshot
        text jalur_unit_snapshot
        varchar lokasi_snapshot
        varchar merk_snapshot
        varchar nomor_seri_snapshot "Nullable"
        int jumlah_snapshot
        varchar kondisi_snapshot
        text penanggung_jawab_snapshot "Pegawai dan jenis tanggung jawab saat direkam"
        decimal nilai_kekritisan
        text dasar_kekritisan
        datetime direkam_pada
    }

    %% [REVISI] Composite FK (risiko_id, asesmen_id) -> RISIKO(id, asesmen_id)
    %% [REVISI] Composite FK (asesmen_aset_id, asesmen_id) -> ASESMEN_ASET(id, asesmen_id)
    RISIKO_ASET {
        bigint risiko_id PK,FK
        bigint asesmen_aset_id PK,FK "Harus satu asesmen dengan risiko"
        bigint asesmen_id FK "Dijamin sama oleh composite FK"
    }

    %% [REVISI] UNIQUE (risiko_id, tahap)
    %% [REVISI] matriks_id harus memiliki versi_metode_id yang sama dengan ASESMEN_RISIKO.versi_metode_id
    PENILAIAN_RISIKO {
        bigint id PK
        bigint risiko_id FK "UK gabungan dengan tahap"
        bigint matriks_id FK
        bigint dinilai_oleh FK
        varchar tahap "SAAT_INI TARGET_SETELAH AKTUAL_SETELAH"
        text alasan_kemungkinan
        text alasan_dampak
        text kesimpulan
        datetime dinilai_pada
    }

    USULAN_KEPUTUSAN {
        bigint id PK
        bigint penilaian_id FK
        bigint diusulkan_oleh FK
        varchar keputusan
        text alasan
        datetime diusulkan_pada
    }

    KEPUTUSAN_RISIKO {
        bigint id PK
        bigint penilaian_id FK,UK
        bigint diputuskan_oleh FK
        varchar keputusan
        text alasan
        datetime diputuskan_pada
    }

    REVIEW_ASESMEN {
        bigint id PK
        bigint asesmen_id FK
        bigint reviewer_id FK
        varchar tahap
        varchar keputusan
        text catatan
        datetime waktu
    }

    %% ---------- PENANGANAN RISIKO ----------
    RENCANA_KERJA {
        bigint id PK
        varchar kode UK
        text uraian_template
    }

    %% [REVISI] UNIQUE (asesmen_id, kode) dan UNIQUE (id, asesmen_id)
    RENCANA_PENANGANAN {
        bigint id PK "UK gabungan dengan asesmen_id"
        bigint asesmen_id FK
        bigint rencana_kerja_id FK "Nullable"
        bigint pic_id FK
        varchar kode "UK gabungan dengan asesmen_id"
        text uraian
        date target_selesai
        varchar status
    }

    %% [REVISI] Composite FK (risiko_id, asesmen_id) -> RISIKO(id, asesmen_id)
    %% [REVISI] Composite FK (rencana_penanganan_id, asesmen_id) -> RENCANA_PENANGANAN(id, asesmen_id)
    RISIKO_PENANGANAN {
        bigint risiko_id PK,FK
        bigint rencana_penanganan_id PK,FK
        bigint asesmen_id FK "Dijamin sama oleh composite FK"
    }

    PROGRES_PENANGANAN {
        bigint id PK
        bigint rencana_penanganan_id FK
        bigint dilaporkan_oleh FK
        text uraian
        varchar status
        datetime dilaporkan_pada
    }

    %% ---------- STANDAR, KONTROL, REGULASI ----------
    STANDAR_KONTROL {
        bigint id PK
        varchar nama
        varchar versi
        text referensi
    }

    %% [REVISI] UNIQUE (standar_id, kode)
    KONTROL {
        bigint id PK
        bigint standar_id FK "UK gabungan dengan kode"
        bigint parent_id FK "Nullable untuk bagian teratas"
        varchar kode
        varchar nama
        varchar jenis "BAGIAN OBJEKTIF KONTROL"
        text deskripsi
    }

    REGULASI {
        bigint id PK
        varchar kode UK
        varchar nama
        text referensi
    }

    RISIKO_KONTROL {
        bigint risiko_id PK,FK
        bigint kontrol_id PK,FK
        text alasan_relevansi
    }

    %% [REVISI] UNIQUE (unit_pemilik_id, kode)
    KONTROL_INTERNAL {
        bigint id PK
        bigint unit_pemilik_id FK "UK gabungan dengan kode"
        varchar kode
        varchar nama
        varchar jenis "SOP KEBIJAKAN TEKNIS FISIK LAINNYA"
        text deskripsi
        boolean aktif
    }

    %% [REVISI] Tambah snapshot kontrol internal agar riwayat tidak berubah saat master diedit
    RISIKO_KONTROL_INTERNAL {
        bigint risiko_id PK,FK
        bigint kontrol_internal_id PK,FK
        varchar kode_snapshot
        varchar nama_snapshot
        varchar jenis_snapshot
        varchar status_penerapan
        text kondisi_penerapan
        datetime diperiksa_pada
    }

    KONTROL_INTERNAL_STANDAR {
        bigint kontrol_internal_id PK,FK
        bigint kontrol_id PK,FK
        text keterangan
    }

    %% [REVISI] UNIQUE (unit_pemilik_id, kode)
    DOKUMEN {
        bigint id PK
        bigint unit_pemilik_id FK
        bigint dibuat_oleh FK
        varchar kode "UK gabungan dengan unit_pemilik_id"
        varchar judul
        varchar jenis "SOP BUKTI LAPORAN PENDUKUNG"
        datetime dibuat_pada
    }

    %% [REVISI] Tambah dokumen_id (UK) agar SOP terikat ke satu DOKUMEN berjenis SOP.
    %%          kode, judul, dan unit_pemilik_id wajib konsisten dengan DOKUMEN tersebut (validasi service/trigger).
    SOP {
        bigint id PK
        bigint dokumen_id FK,UK "DOKUMEN.jenis harus SOP"
        bigint unit_pemilik_id FK
        varchar kode "UK gabungan dengan unit_pemilik_id"
        varchar judul
    }

    %% [REVISI] UNIQUE (sop_id, nomor_versi)
    %% [REVISI] nomor_versi menjadi int dan harus sama dengan DOKUMEN_VERSI.nomor_versi
    %% [REVISI] DOKUMEN_VERSI.dokumen_id harus sama dengan SOP.dokumen_id
    %% [REVISI] status di sini adalah status alur pengesahan SOP, berbeda dari DOKUMEN_VERSI.status (DRAFT/FINAL)
    SOP_VERSI {
        bigint id PK
        bigint sop_id FK "UK gabungan dengan nomor_versi"
        bigint dokumen_versi_id FK
        bigint dibuat_oleh FK
        int nomor_versi
        date tanggal_berlaku
        varchar status
        datetime dibuat_pada
    }

    SOP_REVIEW {
        bigint id PK
        bigint sop_versi_id FK
        bigint reviewer_id FK
        varchar tahap
        varchar keputusan
        text catatan
        datetime waktu
    }

    KONTROL_INTERNAL_SOP {
        bigint kontrol_internal_id PK,FK
        bigint sop_versi_id PK,FK
    }

    SOP_KONTROL {
        bigint sop_versi_id PK,FK
        bigint kontrol_id PK,FK
    }

    %% [REVISI] sop_versi_id harus milik unit yang sama dengan asesmen dari rencana_penanganan (validasi service)
    PENANGANAN_SOP {
        bigint rencana_penanganan_id PK,FK
        bigint sop_versi_id PK,FK
    }

    %% ---------- SOA ----------
    %% [REVISI] UNIQUE (unit_id, periode_id, standar_id)
    SOA {
        bigint id PK
        bigint unit_id FK "UK gabungan dengan periode_id dan standar_id"
        bigint periode_id FK
        bigint standar_id FK
        text ruang_lingkup
    }

    %% [REVISI] UNIQUE (soa_id, nomor_versi)
    SOA_VERSI {
        bigint id PK
        bigint soa_id FK "UK gabungan dengan nomor_versi"
        bigint dibuat_oleh FK
        varchar nomor_versi
        varchar status
        datetime dibuat_pada
        datetime dibekukan_pada "Nullable"
    }

    %% [REVISI] UNIQUE (soa_versi_id, kontrol_id)
    %% [REVISI] kontrol_id harus milik SOA.standar_id dari soa_versi_id terkait (validasi service/trigger)
    SOA_DETAIL {
        bigint id PK
        bigint soa_versi_id FK "UK gabungan dengan kontrol_id"
        bigint kontrol_id FK
        bigint penanggung_jawab_id FK "Nullable jika tidak berlaku"
        boolean berlaku
        text alasan
        varchar status_penerapan
    }

    SOA_BENCHMARK {
        bigint id PK
        bigint soa_detail_id FK
        bigint regulasi_id FK
        varchar rujukan
    }

    SOA_DETAIL_SOP {
        bigint soa_detail_id PK,FK
        bigint sop_versi_id PK,FK
    }

    SOA_REVIEW {
        bigint id PK
        bigint soa_versi_id FK
        bigint reviewer_id FK
        varchar tahap
        varchar keputusan
        text catatan
        datetime waktu
    }

    %% ---------- BUKTI ----------
    %% [REVISI] Tambah dilampirkan_oleh dan dilampirkan_pada pada seluruh BUKTI_*
    %% [REVISI] dokumen_versi_id wajib berstatus FINAL
    BUKTI_PENILAIAN {
        bigint penilaian_id PK,FK
        bigint dokumen_versi_id PK,FK
        bigint dilampirkan_oleh FK
        text keterangan
        datetime dilampirkan_pada
    }

    BUKTI_SOA {
        bigint soa_detail_id PK,FK
        bigint dokumen_versi_id PK,FK
        bigint dilampirkan_oleh FK
        text keterangan
        datetime dilampirkan_pada
    }

    BUKTI_PENANGANAN {
        bigint progres_penanganan_id PK,FK
        bigint dokumen_versi_id PK,FK
        bigint dilampirkan_oleh FK
        text keterangan
        datetime dilampirkan_pada
    }

    %% =====================================================
    SERI_ASESMEN {
        bigint id PK
        varchar kode UK
        varchar nama
    }

    %% [REVISI] Pasangan (kontrol_internal_id, sop_versi_id) harus ada di KONTROL_INTERNAL_SOP
    RISIKO_KONTROL_SOP {
        bigint risiko_id PK,FK
        bigint kontrol_internal_id PK,FK
        bigint sop_versi_id PK,FK
    }

    %% [REVISI] risiko harus berasal dari asesmen dengan unit_id dan periode_id yang sama dengan SOA dari soa_detail
    SOA_DETAIL_RISIKO {
        bigint soa_detail_id PK,FK
        bigint risiko_id PK,FK
    }

    %% ATURAN INTEGRITAS DOKUMENTASI (diterapkan melalui migration, constraint, dan service):
    %% 1. UNIQUE (dokumen_id, nomor_versi) pada DOKUMEN_VERSI.
    %% 2. DRAFT boleh memiliki isi_teks kosong dan tanpa lampiran.
    %% 3. FINAL wajib memiliki isi_teks tidak kosong ATAU minimal satu FILE_LAMPIRAN
    %%    dengan status_pemeriksaan = AMAN yang terhubung melalui DOKUMEN_VERSI_FILE.
    %%    (Melibatkan lebih dari satu tabel: diterapkan lewat trigger atau validasi service, bukan CHECK biasa.)
    %% 4. SOP/bukti yang digunakan dalam proses pengesahan harus menunjuk DOKUMEN_VERSI
    %%    dengan status = FINAL.
    %% 5. Setelah dibekukan, isi_teks, daftar lampiran, dan isi file tidak boleh ditimpa;
    %%    perubahan harus membuat versi baru.
    %% 6. FILE_LAMPIRAN tidak boleh dihapus selama masih dirujuk oleh DOKUMEN_VERSI_FILE
    %%    (DOKUMEN_VERSI_FILE.file_id memakai ON DELETE RESTRICT).
    %% [REVISI] 7. Setelah ASESMEN_RISIKO berstatus DISAHKAN, RISIKO, PENILAIAN_RISIKO, ASESMEN_ASET,
    %%    USULAN_KEPUTUSAN, KEPUTUSAN_RISIKO, RISIKO_ASET, RISIKO_KONTROL, RISIKO_KONTROL_INTERNAL,
    %%    RISIKO_KONTROL_SOP, dan RISIKO_PENANGANAN tidak boleh diubah atau dihapus;
    %%    perubahan harus membuat ASESMEN_RISIKO versi baru.
    %% [REVISI] 8. Master yang sudah dirujuk data tersahkan (ANCAMAN, KERENTANAN, AREA_DAMPAK, KONTROL_INTERNAL, dll.)
    %%    hanya boleh dinonaktifkan (aktif = false), tidak boleh diubah isinya; snapshot menjaga laporan lama.
    %% [REVISI] 9. Kolom status, tahap, dan keputusan pada seluruh tabel wajib dibatasi
    %%    dengan CHECK constraint atau tabel enum sesuai nilai yang dibakukan tim.
    %% [REVISI] 10. Relasi lintas asesmen dijaga composite FK (asesmen_id) pada RISIKO_ASET dan RISIKO_PENANGANAN;
    %%    SOA_DETAIL_RISIKO dan PENILAIAN_RISIKO.matriks_id dijaga trigger/service.

    %% ---------- VERSI DOKUMEN DAN FILE LAMPIRAN ----------
    %% UNIQUE (dokumen_id, nomor_versi)
    DOKUMEN_VERSI {
        bigint id PK
        bigint dokumen_id FK
        bigint dibuat_oleh FK
        int nomor_versi
        text isi_teks "Nullable jika hanya unggahan"
        varchar format_teks "PLAIN MARKDOWN RICH_TEXT_JSON"
        varchar status "DRAFT FINAL"
        datetime dibuat_pada
        datetime dibekukan_pada "Nullable"
    }

    FILE_LAMPIRAN {
        bigint id PK
        bigint diunggah_oleh FK
        varchar nama_asli
        varchar storage_key UK
        varchar ekstensi
        varchar mime_type_terdeteksi
        bigint ukuran_byte
        varchar checksum_sha256
        varchar status_pemeriksaan "PENDING AMAN DITOLAK"
        datetime diunggah_pada
    }

    DOKUMEN_VERSI_FILE {
        bigint dokumen_versi_id PK,FK
        bigint file_id PK,FK "ON DELETE RESTRICT"
        varchar keterangan
        int urutan
    }

    %% =====================================================
    %% RELASI
